{
	"name": "wordpress-agent-kit",
	"version": "0.8.4",
	"description": "WordPress-focused AGENTS.md + Agent Skills starter kit for AI coding agents.",
	"license": "GPL-2.0-or-later",
	"author": "Kyle Brodeur <kyle@brodeur.me> (https://brodeur.me)",
	"homepage": "https://brodeur.me",
	"private": false,
	"type": "module",
	"keywords": [
		"wordpress",
		"agents",
		"agents-md",
		"agent-skills",
		"ai-coding",
		"copilot",
		"pi-package"
	],
	"engines": {
		"node": ">=20.18"
	},
	"packageManager": "pnpm@10.33.2",
	"bin": {
		"wp-agent-kit": "dist/cli.js"
	},
	"exports": {
		".": "./dist/cli.js",
		"./api": "./dist/lib/api.js"
	},
	"pi": {
		"extensions": [
			"./extensions/wp-agent-kit"
		]
	},
	"scripts": {
		"dev": "tsx src/cli.ts",
		"build": "tsc",
		"check": "tsc --noEmit",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"prepare": "husky",
		"install:kit": "tsx src/cli.ts install",
		"skills:install": "tsx src/cli.ts skills install",
		"skills:update": "tsx src/cli.ts skills update",
		"setup": "tsx src/cli.ts setup",
		"playground": "tsx src/cli.ts playground",
		"build:bundles": "tsx scripts/build-bundles.ts",
		"lint": "biome check --write .",
		"lint:check": "biome check .",
		"format": "biome format --write .",
		"format:check": "biome format --check .",
		"prepublishOnly": "pnpm run build && pnpm run lint:check && pnpm run test:run"
	},
	"dependencies": {
		"@clack/prompts": "^1.7.0",
		"commander": "^15.0.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"@earendil-works/pi-coding-agent": "^0.80.3",
		"@types/node": "^22.10.1",
		"@vitest/coverage-v8": "^4.1.10",
		"husky": "^9.1.6",
		"ts-node": "^10.9.2",
		"tsx": "^4.23.0",
		"typebox": "*",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^4.1.11"
	},
	"pnpm": {
		"overrides": {
			"fast-xml-parser": ">=5.7.0",
			"undici": ">=8.10.2 <9",
			"postcss": ">=8.5.23 <9",
			"brace-expansion": ">=5.0.7 <6",
			"source-map-js": ">=1.2.2 <2",
			"@vitest/mocker": ">=4.1.11 <5"
		}
	}
}
